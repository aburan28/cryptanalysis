+            ("campaigns/table/ckpt/slot-00000.ck", self.recent, ckpt(100, 3, 16)),
+            ("campaigns/dp34/campaign.json", self.recent, self.campaign(dpWeight=34)),
+            ("campaigns/dp34/ckpt/slot-00000.ck", self.recent, ckpt(100, 3, 16)),
