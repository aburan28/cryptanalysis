+def _scopedRate(current, now, scopes, base):
+    at, before = base
+    shared = sorted(set(scopes) & set(before))
+    span = (now - at).total_seconds()
+    # A slot resumed from an older checkpoint moves its prefix backwards; that
+    # is no walk at all, not negative work.
+    walked = sum(max(0, scopes[k] - before[k]) for k in shared)
+    return {
+        "iterations_per_second": walked / span,
+        "window_seconds": int(round(span)),
+        "measured_from": at.strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "measured_to": current.get("generated_at"),
+        "iterations_from": sum(before[k] for k in shared),
+        "iterations_to": sum(scopes[k] for k in shared),
+        "scopes": shared,
+        "method": ("difference of checkpointed totals per S3 prefix against a sample "
