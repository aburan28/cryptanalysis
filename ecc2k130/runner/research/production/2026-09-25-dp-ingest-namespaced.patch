+class NamespacedWork(unittest.TestCase):
+    """The runner's namespaced fleet walks this campaign; its checkpoints are this work."""
+
+    def setUp(self):
+        self.recent = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=30)
+
+    def campaign(self, campaignId="ecc2k-130", dpWeight=32):
+        return json.dumps({"campaignId": campaignId, "dpWeight": dpWeight}).encode()
+
+    def test_a_shared_namespace_adds_its_checkpoints(self):
+        s3 = FakeNamespaceS3([
+            ("ckpt/slot-00002.ck", self.recent, ckpt(10, 2, 4)),
+            ("campaigns/fleet/campaign.json", self.recent, self.campaign()),
+            ("campaigns/fleet/ckpt/slot-00000.ck", self.recent, ckpt(100, 3, 16, runId=12000)),
+            ("campaigns/fleet/ckpt/slot-00002.ck", self.recent, ckpt(200, 3, 16, runId=12002)),
+        ])
+        total, slots = dp_ingest.checkpointWork(s3, "bucket")
+        self.assertEqual(total, 80 + 100 * 48 + 200 * 48)
+        self.assertEqual(sorted((s["prefix"], s["slot"]) for s in slots),
+                         [("", 2), ("campaigns/fleet/", 0), ("campaigns/fleet/", 2)])
+        self.assertEqual(dp_ingest.workScopesOf(slots),
+                         {"": 80, "campaigns/fleet/": 100 * 48 + 200 * 48})
+
+    def test_other_walks_and_cutoffs_are_not_this_campaign(self):
+        s3 = FakeNamespaceS3([
