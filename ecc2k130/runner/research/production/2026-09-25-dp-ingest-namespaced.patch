+    T = datetime.datetime(2026, 9, 25, 6, 0, tzinfo=datetime.timezone.utc)
+
+    def iso(self, secondsBefore):
+        return (self.T - datetime.timedelta(seconds=secondsBefore)).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+    def current(self, scopes):
+        return {"generated_at": self.iso(0),
+                "work": {"iterations": sum(scopes.values()), "scopes": scopes}}
+
+    def previous(self, history, **extra):
+        return dict({"generated_at": self.iso(180), "work": {"iterations": 1},
+                     "walk_rate_history": history}, **extra)
+
+    def test_the_first_write_after_the_upgrade_measures_the_root_as_before(self):
+        previous = {"generated_at": self.iso(180), "work": {"iterations": 9000},
+                    "walk_rate": {"iterations_from": 1000, "measured_from": self.iso(8000)}}
+        scopes = {"": 9100, "campaigns/fleet/": 10 ** 15}
+        rate, history = dp_ingest.walkRateFromHistory(self.current(scopes), previous)
+        self.assertAlmostEqual(rate["iterations_per_second"], (9100 - 1000) / 8000)
+        self.assertEqual(rate["scopes"], [""])
+        self.assertEqual(history, [{"at": self.iso(0), "scopes": scopes}])
+
+    def test_a_covering_sample_measures_every_scope(self):
+        previous = self.previous([{"at": self.iso(700), "scopes": {"": 1000, "c/": 5000}}])
+        rate, _ = dp_ingest.walkRateFromHistory(self.current({"": 1700, "c/": 12000}), previous)
+        self.assertAlmostEqual(rate["iterations_per_second"], (700 + 7000) / 700)
+        self.assertEqual(rate["window_seconds"], 700)
+        self.assertEqual(rate["scopes"], ["", "c/"])
+
+    def test_the_base_is_the_newest_sample_an_hour_old(self):
+        samples = [(7200, 0), (3700, 3700), (3500, 3900), (600, 6800)]
+        previous = self.previous([{"at": self.iso(s), "scopes": {"": v}} for s, v in samples])
+        rate, _ = dp_ingest.walkRateFromHistory(self.current({"": 7400}), previous)
+        self.assertEqual(rate["measured_from"], self.iso(3700))
+        self.assertAlmostEqual(rate["iterations_per_second"], (7400 - 3700) / 3700)
+
+    def test_a_partial_sample_is_used_only_without_a_covering_one(self):
+        previous = self.previous([{"at": self.iso(4000), "scopes": {"": 1000}},
+                                  {"at": self.iso(300), "scopes": {"": 4700, "c/": 10 ** 12}}])
+        rate, _ = dp_ingest.walkRateFromHistory(
+            self.current({"": 5000, "c/": 10 ** 12 + 3000}), previous)
+        self.assertEqual(rate["scopes"], [""])
+        self.assertAlmostEqual(rate["iterations_per_second"], 4000 / 4000)
+
+    def test_a_scope_that_moves_backwards_walked_nothing(self):
+        previous = self.previous([{"at": self.iso(1000), "scopes": {"": 100, "c/": 500}}])
+        rate, _ = dp_ingest.walkRateFromHistory(self.current({"": 1100, "c/": 400}), previous)
+        self.assertAlmostEqual(rate["iterations_per_second"], 1000 / 1000)
+
+    def test_history_is_sampled_and_trimmed(self):
+        entries = [{"at": self.iso(dp_ingest.WALK_RATE_KEEP_S + 60), "scopes": {"": 1}},
+                   {"at": self.iso(1200), "scopes": {"": 2}},
+                   {"at": self.iso(100), "scopes": {"": 3}}]
+        _, history = dp_ingest.walkRateFromHistory(self.current({"": 4}), self.previous(entries))
+        self.assertEqual([h["at"] for h in history], [self.iso(1200), self.iso(100)])
+        _, history = dp_ingest.walkRateFromHistory(self.current({"": 4}), self.previous(entries[:2]))
+        self.assertEqual([h["at"] for h in history], [self.iso(1200), self.iso(0)])
