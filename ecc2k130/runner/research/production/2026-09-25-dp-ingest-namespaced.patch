+    def test_publish_carries_the_history_forward(self):
+        puts = []
+        previous = self.previous([{"at": self.iso(700), "scopes": {"": 1000, "c/": 5000}}])
+
+        class StatusS3:
+            def get_object(self, **kw):
+                return {"Body": io.BytesIO(json.dumps(previous).encode())}
+
+            def put_object(self, **kw):
+                puts.append(json.loads(kw["Body"].decode()))
+
+        slots = [{"slot": 0, "prefix": "", "run_id": 1, "retired": False, "checkpoint_age_s": 5,
+                  "walks": 1, "per_walk_steps": 1, "iterations": 1700},
+                 {"slot": 0, "prefix": "c/", "run_id": 2, "retired": False, "checkpoint_age_s": 5,
+                  "walks": 1, "per_walk_steps": 1, "iterations": 12000}]
+        with mock.patch.object(dp_ingest, "checkpointWork", return_value=(13700, slots)), \
+                mock.patch.object(dp_ingest.time, "gmtime", return_value=self.T.timetuple()):
+            dp_ingest.publishStatus(None, StatusS3(), "bucket", "status",
+                                    snapshot={"dps": 1, "dps_last_hour": 1, "hourly": []})
+        body = puts[0]
+        self.assertAlmostEqual(body["walk_rate"]["iterations_per_second"], (700 + 7000) / 700)
+        self.assertEqual(body["walk_rate_history"][-1]["scopes"], {"": 1700, "c/": 12000})
+        self.assertNotIn("per_slot", body["work"])
