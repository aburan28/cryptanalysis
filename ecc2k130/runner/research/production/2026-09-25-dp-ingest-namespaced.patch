+class SweepCursor:
+    def __init__(self, db):
+        self.db = db
+        self.result = []
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def execute(self, sql, params=()):
+        db, sql = self.db, " ".join(sql.split())
+        self.result = []
+        if sql.startswith("SELECT 1 FROM dp_ingest_totals"):
+            self.result = [(1,)]
+        elif sql.startswith("SELECT at FROM dp_ingest_meta"):
+            self.result = [(db.meta[params[0]],)] if params[0] in db.meta else []
+        elif sql.startswith("INSERT INTO dp_ingest_meta (key, at) VALUES (%s, %s)"):
+            db.meta.setdefault(params[0], params[1])
+        elif sql.startswith("SELECT least("):
+            since, chunk, lag = params[0], params[1], params[2]
+            limit = db.now - datetime.timedelta(seconds=lag)
+            end = since + datetime.timedelta(seconds=chunk)
+            self.result = [(min(end, limit), end >= limit)]
+        elif sql.startswith("SELECT date_trunc('hour', found_at)"):
+            _, since, until = params
+            hours = {}
+            for at, worker in db.points:
+                if since < at <= until and not (worker or "").startswith("dp-"):
+                    h = hours.setdefault(at.replace(minute=0, second=0, microsecond=0), [])
+                    h.append(at)
+            self.result = [(h, len(v), min(v), max(v)) for h, v in hours.items()]
+        elif sql.startswith("UPDATE dp_ingest_totals SET dps = dps + %s"):
+            db.totals += params[0]
+        elif sql.startswith("INSERT INTO dp_ingest_hourly"):
+            db.hourly[params[1]] = db.hourly.get(params[1], 0) + params[2]
+        elif sql.startswith("UPDATE dp_ingest_meta SET at = %s"):
+            db.meta[params[1]] = params[0]
+        elif not sql.startswith("INSERT INTO dp_ingest_totals (campaign_id) VALUES"):
+            raise AssertionError("unexpected SQL: " + sql)
+
+    def fetchone(self):
+        return self.result[0] if self.result else None
+
+    def fetchall(self):
+        return list(self.result)
+
+
+class SweepConn:
+    """meta, totals, hourly and points: just enough of rho-dp for the sweep."""
+
+    def __init__(self, now, points, meta):
+        self.now, self.points, self.meta = now, points, dict(meta)
+        self.totals, self.hourly, self.commits = 0, {}, 0
+
+    def cursor(self):
+        return SweepCursor(self)
+
+    def commit(self):
+        self.commits += 1
+
+    def rollback(self):
+        pass
+
