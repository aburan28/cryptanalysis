+class DirectReports(unittest.TestCase):
+    """Rows written by report_dp reach the counters once each, never twice."""
+
+    NOW = datetime.datetime(2026, 9, 25, 6, 0, tzinfo=datetime.timezone.utc)
+
+    def ago(self, seconds):
+        return self.NOW - datetime.timedelta(seconds=seconds)
+
+    def test_counts_direct_rows_since_the_seed_and_only_those(self):
+        points = [(self.ago(7000), "modal:gpu0:a"),       # before the seed: in it already
+                  (self.ago(5000), "dp-slot-00208-x"),    # this program's own, via applyRollup
+                  (self.ago(5000), "modal:gpu0:a"),
+                  (self.ago(4000), "modal:gpu0:b"),
+                  (self.ago(4000), None),
+                  (self.ago(120), "modal:gpu0:a")]        # inside the lag: not yet
+        db = SweepConn(self.NOW, points, {dp_ingest.ROLLUP_MARK: self.ago(6000)})
+        self.assertEqual(dp_ingest.sweepDirectReports(db, lag=300, chunk=3600), 3)
+        self.assertEqual(db.totals, 3)
+        self.assertEqual(sum(db.hourly.values()), 3)
+        self.assertEqual(db.meta[dp_ingest.DIRECT_MARK], self.ago(300))
+        self.assertEqual(dp_ingest.sweepDirectReports(db, lag=300, chunk=3600), 0)
+        db.now = self.NOW + datetime.timedelta(seconds=600)
+        self.assertEqual(dp_ingest.sweepDirectReports(db, lag=300, chunk=3600), 1)
+        self.assertEqual(db.totals, 4)
+
+    def test_catches_up_one_chunk_per_transaction_within_the_budget(self):
+        points = [(self.ago(s), "modal:gpu0:a") for s in (17000, 13000, 9000, 5000, 1000)]
+        db = SweepConn(self.NOW, points, {dp_ingest.ROLLUP_MARK: self.ago(18000)})
+        self.assertEqual(dp_ingest.sweepDirectReports(db, budget=0, lag=300, chunk=3600), 1)
+        self.assertEqual(db.commits, 1)
+        self.assertEqual(dp_ingest.sweepDirectReports(db, lag=300, chunk=3600), 4)
+        self.assertEqual(db.totals, 5)
+        self.assertEqual(db.commits, 5)
+
+    def test_waits_for_the_counters_to_be_seeded(self):
+        db = SweepConn(self.NOW, [(self.ago(100), "modal:gpu0:a")], {})
+        self.assertEqual(dp_ingest.sweepDirectReports(db), 0)
+        self.assertNotIn(dp_ingest.DIRECT_MARK, db.meta)
+        self.assertEqual(db.totals, 0)
