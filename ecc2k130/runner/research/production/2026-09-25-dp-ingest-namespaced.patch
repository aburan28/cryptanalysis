+def _pickBase(entries, now):
+    aged = [e for e in entries if (now - e[0]).total_seconds() >= WALK_RATE_WINDOW_S]
+    if aged:
+        return aged[-1]
+    ready = [e for e in entries if (now - e[0]).total_seconds() >= MIN_WALK_RATE_SPAN_S]
+    return ready[0] if ready else None
+
