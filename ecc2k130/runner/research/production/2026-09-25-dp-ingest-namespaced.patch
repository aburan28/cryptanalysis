+# Points other writers insert -- the ecc2k130 runner's workers call
+# `report_dp` directly, and its rows never pass through `applyRollup` -- are
+# added to the counters by a sweep over `found_at`, once each: every row this
+# program writes has a `dp-` worker_id, so a row is counted either here or
+# there and never both. `report_dp` runs one autocommit statement per point,
+# so a row older than DIRECT_REPORT_LAG_S is committed; the watermark in
+# dp_ingest_meta advances in the same transaction as the counts it covers.
+DIRECT_MARK = "direct_reports_counted_to"
+DIRECT_REPORT_LAG_S = 300
+DIRECT_CHUNK_S = 3600
+DIRECT_BUDGET_S = 45.0
+
+
+def sweepQuietly(conn):
+    """The sweep is bookkeeping for the page; it never stops a publish."""
+    try:
+        return sweepDirectReports(conn)
+    except Exception as exc:
+        try:
+            conn.rollback()
+        except Exception:
+            pass
+        log("direct report sweep failed: %s: %s" % (type(exc).__name__, exc))
+        return 0
+
+
+def sweepDirectReports(conn, budget=DIRECT_BUDGET_S, lag=DIRECT_REPORT_LAG_S,
+                       chunk=DIRECT_CHUNK_S):
+    """Add points written behind this program's back to the counters.
+
+    Starts from the rollup seed, which counted everything before it, and
+    catches up one `chunk` of `found_at` per transaction until it is `lag`
+    behind the database clock or has spent `budget` seconds. Returns the
+    number of points added. Takes the totals row first, the same order as
+    `ensureRollup`, so an ingest's `applyRollup` waits rather than
+    interleaving.
+    """
+    started, added = time.time(), 0
+    while True:
+        with conn.cursor() as cur:
+            cur.execute("INSERT INTO dp_ingest_totals (campaign_id) VALUES (%s) "
+                        "ON CONFLICT (campaign_id) DO NOTHING", (CAMPAIGN,))
+            cur.execute("SELECT 1 FROM dp_ingest_totals WHERE campaign_id = %s FOR UPDATE",
+                        (CAMPAIGN,))
+            cur.execute("SELECT at FROM dp_ingest_meta WHERE key = %s FOR UPDATE", (DIRECT_MARK,))
+            row = cur.fetchone()
+            if row is None:
+                cur.execute("SELECT at FROM dp_ingest_meta WHERE key = %s", (ROLLUP_MARK,))
+                seeded = cur.fetchone()
+                if seeded is None:
+                    conn.rollback()
+                    return added
+                cur.execute("INSERT INTO dp_ingest_meta (key, at) VALUES (%s, %s) "
+                            "ON CONFLICT (key) DO NOTHING", (DIRECT_MARK, seeded[0]))
+                cur.execute("SELECT at FROM dp_ingest_meta WHERE key = %s FOR UPDATE",
+                            (DIRECT_MARK,))
+                row = cur.fetchone()
+            since = row[0]
+            # clock_timestamp, not now(): now() is when the transaction began,
+            # which on a reused connection can be older than the rows to count.
+            cur.execute("SELECT least(%s::timestamptz + make_interval(secs => %s), "
+                        "clock_timestamp() - make_interval(secs => %s)), "
+                        "%s::timestamptz + make_interval(secs => %s) >= "
+                        "clock_timestamp() - make_interval(secs => %s)",
+                        (since, chunk, lag, since, chunk, lag))
+            until, last = cur.fetchone()
+            if until <= since:
+                conn.rollback()
+                return added
+            cur.execute(
+                "SELECT date_trunc('hour', found_at), count(*), min(found_at), max(found_at) "
+                "FROM distinguished_points "
+                "WHERE campaign_id = %s AND found_at > %s AND found_at <= %s "
+                "  AND (worker_id IS NULL OR worker_id NOT LIKE 'dp-%%') "
+                "GROUP BY 1", (CAMPAIGN, since, until))
+            rows = cur.fetchall()
+            n = sum(int(r[1]) for r in rows)
+            if n:
+                cur.execute(
+                    "UPDATE dp_ingest_totals SET dps = dps + %s, "
+                    "  first_dp_at = least(first_dp_at, %s), "
+                    "  last_dp_at = greatest(last_dp_at, %s) WHERE campaign_id = %s",
+                    (n, min(r[2] for r in rows), max(r[3] for r in rows), CAMPAIGN))
+                for hour, count, _, _ in rows:
+                    cur.execute(
+                        "INSERT INTO dp_ingest_hourly (campaign_id, hour, dps) VALUES (%s, %s, %s) "
+                        "ON CONFLICT (campaign_id, hour) DO UPDATE SET "
+                        "  dps = dp_ingest_hourly.dps + EXCLUDED.dps",
+                        (CAMPAIGN, hour, int(count)))
+            cur.execute("UPDATE dp_ingest_meta SET at = %s WHERE key = %s", (until, DIRECT_MARK))
+        conn.commit()
+        added += n
+        if n:
+            log("counted %d directly reported points up to %s" % (n, until))
+        if last or time.time() - started >= budget:
+            return added
+
