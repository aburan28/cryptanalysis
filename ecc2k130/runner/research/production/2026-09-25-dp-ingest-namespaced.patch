+def workScopes(status):
+    """`{prefix: iterations}` of one document, or None.
+
+    A document written before scopes existed counted the bucket root only.
+    """
+    work = (status or {}).get("work") or {}
+    try:
+        if isinstance(work.get("scopes"), dict):
+            return {str(k): int(v) for k, v in work["scopes"].items()}
+        total = int(work.get("iterations"))
+    except (TypeError, ValueError):
+        return None
+    return {"": total} if total > 0 else None
+
