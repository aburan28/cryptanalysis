+def workScopesOf(per_slot):
+    """Checkpointed iterations per S3 prefix; "" is the bucket root."""
+    scopes = {"": 0}
+    for slot in per_slot:
+        prefix = slot.get("prefix") or ""
+        scopes[prefix] = scopes.get(prefix, 0) + int(slot["iterations"])
+    return scopes
