+        if not isinstance(entry, dict):
+            continue
+        at = parseIso(entry.get("at"))
+        scopes = workScopes({"work": {"scopes": entry.get("scopes")}}) \
+            if isinstance(entry.get("scopes"), dict) else None
+        if at is not None and scopes:
+            entries.append((at, scopes))
