+class FakeNamespaceS3:
+    """Prefix-aware listing with delimiters, campaign.json reads, ranged gets."""
+
+    def __init__(self, objects):
+        self.objects = {k: (t, b) for k, t, b in objects}
+
+    def list_objects_v2(self, **kw):
+        prefix = kw.get("Prefix", "")
+        keys = sorted(k for k in self.objects if k.startswith(prefix))
+        if kw.get("Delimiter"):
+            common = sorted({prefix + k[len(prefix):].split("/", 1)[0] + "/"
+                             for k in keys if "/" in k[len(prefix):]})
+            return {"CommonPrefixes": [{"Prefix": p} for p in common], "IsTruncated": False}
+        return {"Contents": [{"Key": k, "Size": len(self.objects[k][1]),
+                              "LastModified": self.objects[k][0]} for k in keys],
+                "IsTruncated": False}
+
+    def get_object(self, **kw):
+        if kw["Key"] not in self.objects:
+            raise KeyError("NoSuchKey: " + kw["Key"])
+        body = self.objects[kw["Key"]][1]
+        rng = kw.get("Range")
+        if rng:
+            lo, hi = rng.split("=", 1)[1].split("-")
+            body = body[int(lo):int(hi) + 1]
+        return {"Body": io.BytesIO(body)}
+
