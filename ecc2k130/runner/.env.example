# Copy to .env and replace placeholders locally before creating the Modal secret.
ECC_BUCKET=REPLACE_WITH_CAMPAIGN_BUCKET
AWS_DEFAULT_REGION=REPLACE_WITH_BUCKET_REGION
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
# Required for temporary AWS credentials; omit for credentials without a token.
# AWS_SESSION_TOKEN=REPLACE_WITH_SESSION_TOKEN
RHO_DP_DSN=postgresql://USER@HOST:5432/DATABASE?sslmode=verify-full
PGPASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Supplied by the image; campaign.json is created only if it does not exist.
# ECC_PREFIX=campaigns/ecc2k130-frobenius32-120k-v1
# Optional managed Modal ingress: export this on the local launcher.
# ECC_RDS_SECURITY_GROUP=YOUR_RDS_SECURITY_GROUP
