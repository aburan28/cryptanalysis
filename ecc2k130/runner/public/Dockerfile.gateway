FROM python:3.12-slim
RUN pip install --no-cache-dir 'psycopg[binary]>=3.2,<4' 'boto3>=1.38,<2' \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin ecc2k \
    && mkdir -p /data /opt/ecc2k130/aws && chown 10001:10001 /data
COPY ecc2k130/runner/public/*.py /opt/ecc2k130/public/
COPY ecc2k130/runner/aws/rds_gpu.py /opt/ecc2k130/aws/rds_gpu.py
ENV PYTHONUNBUFFERED=1
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080
CMD ["python3", "/opt/ecc2k130/public/server.py", "--state", "/data", \
     "--bind", "0.0.0.0", "--port", "8080"]
