FROM nvidia/cuda:13.3.1-devel-ubuntu24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src/ecc2k130
COPY ecc2k130/Makefile ./
COPY ecc2k130/src/ src/
COPY ecc2k130/include/ include/
COPY ecc2k130/generated/ generated/
COPY ecc2k130/tests/campaign-kat.hex tests/campaign-kat.hex
COPY fpga/model/ecc2k130.c fpga/model/ecc2k130.h /src/fpga/model/
# Compile every supported CUDA generation, plus PTX for later NVIDIA cards.
RUN make test && make gpu WALK=sigma ARCH='-gencode arch=compute_80,code=sm_80 \
    -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 \
    -gencode arch=compute_90,code=sm_90 -gencode arch=compute_100,code=sm_100 \
    -gencode arch=compute_120,code=sm_120 -gencode arch=compute_120,code=compute_120' \
    && build/ec2k-gpu check --kat tests/campaign-kat.hex

FROM nvidia/cuda:13.3.1-runtime-ubuntu24.04
LABEL org.opencontainers.image.source="https://github.com/aburan28/cryptanalysis"
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin ecc2k \
    && mkdir -p /opt/ecc2k130 /data && chown 10001:10001 /data
COPY --from=build /src/ecc2k130/build/ec2k-gpu /opt/ecc2k130/ec2k-gpu
COPY --from=build /src/ecc2k130/tests/campaign-kat.hex /opt/ecc2k130/campaign-kat.hex
COPY ecc2k130/runner/public/client.py ecc2k130/runner/public/protocol.py /opt/ecc2k130/
ENV ECC_STATE_DIR=/data ECC_CLIENT=/opt/ecc2k130/ec2k-gpu \
    ECC_KAT=/opt/ecc2k130/campaign-kat.hex PYTHONUNBUFFERED=1
USER 10001:10001
VOLUME ["/data"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "/opt/ecc2k130/client.py"]
