prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: cryptanalysis
Description: Discrete-logarithm cryptanalysis toolkit (rho, BSGS, kangaroo, grumpy giants, Cheon, index calculus)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lcryptanalysis -lpthread -lm
Cflags: -I${includedir}
