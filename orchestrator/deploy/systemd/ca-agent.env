# /etc/ca/agent.env - read by ca-agent@.service.  Mode 0640, owner ca.
CA_SERVER=http://control.internal:8080
CA_BIN=/usr/local/bin/ca
CA_LOG_LEVEL=info
# Must match the control plane's token.
CA_TOKEN=replace-me
# Optional: pin this box to one campaign.
#CA_CAMPAIGN=demo
#CA_LABELS=region=us-west-2,capacity=spot
