# The control plane as a systemd service.
#
# Install:
#   install -m0755 ca-control ca /usr/local/bin/
#   install -m0644 ca-control.service /etc/systemd/system/
#   install -m0640 -o ca -g ca ca-control.env /etc/ca/control.env   # holds the token
#   systemctl enable --now ca-control
[Unit]
Description=Cryptanalysis campaign control plane
Documentation=https://github.com/aburan28/cryptanalysis
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/ca-control serve
EnvironmentFile=/etc/ca/control.env
User=ca
Group=ca
# The drain-then-shutdown sequence needs a moment; systemd's default 90s is
# plenty, but KillSignal is stated explicitly because the process treats
# SIGTERM as "drain", and a SIGKILL here would strand every in-flight lease
# until it expired.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=2s

# The corpus lives here; StateDirectory makes systemd create it with the
# right ownership on first start, which is one less thing in a runbook.
StateDirectory=ca-control
StateDirectoryMode=0750

# Hardening.  The control plane reads one directory, writes one directory and
# listens on one port; everything else is off.  These are not decoration: the
# service holds the fleet's shared token and, on a lucky day, the answer.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
