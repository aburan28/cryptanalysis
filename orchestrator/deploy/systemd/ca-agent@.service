# One agent per instance parameter, so a box with N cores runs N agents:
#   systemctl enable --now ca-agent@{0..7}
#
# A template rather than one process with a thread count, because the unit of
# failure and the unit of work should be the same size: a walker that wedges
# takes one unit down with it, systemd restarts that one instance, and the
# other seven keep walking.
[Unit]
Description=Cryptanalysis walk agent %i
Documentation=https://github.com/aburan28/cryptanalysis
After=network-online.target
Wants=network-online.target
# On a box that also runs the control plane (a single-node deployment), start
# after it; harmless when it is not installed.
After=ca-control.service

[Service]
Type=exec
EnvironmentFile=/etc/ca/agent.env
Environment=CA_AGENT_ID=%H-%i
# Each instance gets its own probe port, so a node exporter or a person can
# ask any one of them what it is doing.
Environment=CA_HEALTH_LISTEN=127.0.0.1:90%i
ExecStart=/usr/local/bin/ca-agent
User=ca
Group=ca

# SIGTERM makes the agent stop the walk, upload what it has and hand the unit
# back.  TimeoutStopSec is the upload's budget; past it the unit's lease
# simply expires and somebody else walks it, which costs steps and nothing
# else.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5s
# Spot instances are reclaimed and agents are meant to be replaceable; do not
# let a restart loop count as a failure that stops the unit forever.
StartLimitIntervalSec=0

# Unit output is written here and uploaded, then deleted.  PrivateTmp gives
# each instance its own, so two agents cannot see each other's files.
Environment=CA_TMPDIR=/tmp
PrivateTmp=yes

# The walker is CPU-bound; nice it so that the box stays usable and a
# control plane sharing the host keeps answering.
Nice=5
IOSchedulingClass=idle

NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
