+/// The GPUs to report once `nvidia-smi` has answered: every one from another
+/// vendor, and the NVIDIA ones it listed. Inside a container `/sys/bus/pci`
+/// is the host's, so the cards rented to the container's neighbours are on
+/// it too; `nvidia-smi` lists only the ones this container can open, and a
+/// node summing the others would count capacity nobody here can use.
+pub fn reachable_gpus(
+    found: Vec<Gpu>,
+    smi_rows: &[(String, String, Option<u64>, String)],
+) -> Vec<Gpu> {
+    let listed: BTreeSet<String> = smi_rows.iter().map(|row| normalise_bus(&row.0)).collect();
+    found
+        .into_iter()
+        .filter(|gpu| {
+            gpu.vendor != "nvidia"
+                || gpu
+                    .bus
+                    .as_deref()
+                    .is_none_or(|bus| listed.contains(&normalise_bus(bus)))
+        })
+        .collect()
+}
+
 /// `nvidia-smi` prints `00000000:17:00.0`; sysfs names the device
 /// `0000:17:00.0`. Compare on the last three segments, lower-cased.
 fn normalise_bus(bus: &str) -> String {
@@ -512,6 +539,37 @@ mod tests {
         assert_eq!(classify_pci("0x10de", "0x0c0330"), None);
     }
 
+    #[test]
+    fn a_container_reports_only_the_gpus_nvidia_smi_lists() {
+        let gpu = |vendor: &str, bus: &str| Gpu {
+            index: 0,
+            vendor: vendor.to_string(),
+            model: None,
+            memory_mb: None,
+            bus: Some(bus.to_string()),
+            driver: None,
+        };
+        // A rented pod on a two-card host, as measured on Runpod: the PCI bus
+        // shows both cards and the host's BMC display, `nvidia-smi` only the
+        // card the pod was given.
+        let found = vec![
+            gpu("nvidia", "0000:4a:00.0"),
+            gpu("nvidia", "0000:ca:00.0"),
+            gpu("pci:1a03", "0000:cc:00.0"),
+        ];
+        let rows =
+            parse_nvidia_smi_csv("00000000:CA:00.0, NVIDIA GeForce RTX 5090, 32607, 570.195.03\n");
+        let kept: Vec<String> = reachable_gpus(found.clone(), &rows)
+            .into_iter()
+            .filter_map(|gpu| gpu.bus)
+            .collect();
+        assert_eq!(kept, ["0000:ca:00.0", "0000:cc:00.0"]);
+        // `No devices were found`: none of the cards is this container's.
+        let kept = reachable_gpus(found, &[]);
+        assert_eq!(kept.len(), 1);
+        assert_eq!(kept[0].vendor, "pci:1a03");
+    }
+
