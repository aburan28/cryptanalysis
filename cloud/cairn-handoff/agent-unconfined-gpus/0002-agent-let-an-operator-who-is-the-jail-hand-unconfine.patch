+rule "a GPU job runs unconfined only where the operator lets it"
+# A host that is itself the jail -- a rented GPU pod, no engine inside --
+# passes --unconfined-gpus. Without it the job is refused with a receipt that
+# names the flag; with it the job runs and its receipt lists gpus as
+# unenforced. No GPU is needed for either: the job never opens one.
+set +e
+"$RUST" agent exec --rootfs / --sandbox none --gpus 1 --id demo-gpu-refused --timeout 30 \
+  --data-dir "$DATA" --json -- /bin/true > "$WORK/gpu-refused.json" 2>/dev/null
+STATUS=$?
+set -e
+[ "$STATUS" -eq 3 ] || fail "an unconfined GPU job without --unconfined-gpus exited $STATUS, not 3"
+"$RUST" agent exec --rootfs / --sandbox none --gpus 1 --unconfined-gpus --id demo-gpu \
+  --timeout 30 --data-dir "$DATA" --json -- /bin/true > "$WORK/gpu.json"
+python3 - "$WORK/gpu-refused.json" "$WORK/gpu.json" <<'PY'
+import json, sys
+refused, ran = (json.load(open(path)) for path in sys.argv[1:])
+assert refused["exit_status"] is None and "--unconfined-gpus" in refused["error"], refused
+assert ran["succeeded"] and ran["sandbox"] == "none" and ran["gpus_requested"] == 1, ran
+assert any(item.startswith("gpus") for item in ran["unenforced"]), ran
+print("  refused without the flag; with it, ran and listed", ran["unenforced"], "as unenforced")
+PY
+set +e
+"$RUST" agent exec --rootfs / --gpus 1 --unconfined-gpus -- /bin/true >/dev/null 2>&1
+[ $? -eq 2 ] || fail "--unconfined-gpus on a host that jails its jobs must be a usage error"
