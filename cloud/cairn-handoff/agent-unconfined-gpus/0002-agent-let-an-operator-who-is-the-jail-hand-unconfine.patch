+/// `--unconfined-gpus` or `CAIRN_AGENT_UNCONFINED_GPUS=1`: a job that runs
+/// unconfined may use this host's GPUs. Only an operator who chose `none`
+/// runs a job unconfined, so on any other host the setting could do nothing,
+/// and a setting that does nothing while looking set is refused rather than
+/// ignored.
+fn unconfined_gpus(parsed: &Parsed, preference: Preference) -> Result<bool, AgentError> {
+    let wanted = parsed.switch("unconfined-gpus")
+        || matches!(std::env::var(UNCONFINED_GPUS_ENV), Ok(value) if value.trim() == "1");
+    if wanted && preference != Preference::None {
+        return Err(AgentError::Invalid(format!(
+            "--unconfined-gpus is for a host whose operator runs jobs unconfined \
+             (--sandbox none); this one runs them under at least `{}`",
+            preference.as_str()
+        )));
+    }
+    Ok(wanted)
+}
