digraph transfers {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.6"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#315c92", fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#315c92"];
  source [label="E / F101: y^2 = x^3 + x + 46\nEC1P7Cfph1bb53caf9319\n|E(F101)| = r = 109; P = (2,37)"];
  image [label="Curve C in projective 3-space\nQ1 = Q2 = 0\nOrigin: [0:0:0:1]\nGroup law on this curve's image", fillcolor="#e6f6ec", color="#26784a"];
  quadrics [label="Q2 + lambda Q1 = 0\n101 smooth containing quadrics\n54 split over F101\nAmbient surface has no supplied group law", fillcolor="#fff2dd", color="#ad7730"];
  product [label="Abelian surface E x E\nComponentwise group law\nTrivial injective embedding", fillcolor="#e6f6ec", color="#26784a"];
  filter [label="Candidate abelian surface A\nFrobenius divisibility is necessary\nMap and kernel remain unconstructed", fillcolor="#f4eef9", color="#80619b"];
  source -> image [label="(x,y) -> [1:x:y:x^2]\ndegree 1 onto the image"];
  image -> source [label="inverse: (X/W,Y/W)\nplus origin case"];
  image -> quadrics [label="containment for every lambda"];
  source -> product [label="P -> (P,O)"];
  source -> filter [style=dashed, label="polynomial filter only\nnot a constructed transfer"];
}
