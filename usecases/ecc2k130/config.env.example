# Public/non-secret identity of the live campaign.
AWS_DEFAULT_REGION=us-west-2
RHO_CAMPAIGN=ecc2k-130
ECC_BUCKET=ecc2k130-590183823895
ECC_STATUS_BUCKET=ecc2k130-status-590183823895

# Set to campaign.json's strict contract id when storageProtocol is
# ecc2k-seed-orbit-v1. Empty is the explicit compatibility setting for the
# current live campaign while its legacy campaign.json is migrated.
ECC2K130_CAMPAIGN_ID=

# RDS path. The password stays in Secrets Manager.
RHO_DB_INSTANCE=rho-dp
RHO_DB_HOST=rho-dp.cxqyicswioh8.us-west-2.rds.amazonaws.com
RHO_DB_SECRET=rho/dp-rds
RHO_DB_SSLMODE=require

# Filled from the CloudFormation/SAM QueueUrl output.
ECC_INGEST_QUEUE_URL=

# Local/operator alternative to RHO_DB_HOST + RHO_DB_SECRET:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
