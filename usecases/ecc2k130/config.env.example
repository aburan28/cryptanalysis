# Public/non-secret identity of the live campaign.
AWS_DEFAULT_REGION=us-west-2
RHO_CAMPAIGN=ecc2k-130
ECC_BUCKET=ecc2k130-590183823895
ECC_STATUS_BUCKET=ecc2k130-status-590183823895

# Set to campaign.json's strict contract id when storageProtocol is
# ecc2k-seed-orbit-v1. Empty is the explicit compatibility setting for the
# current live campaign while its legacy campaign.json is migrated.
ECC2K130_CAMPAIGN_ID=

# RDS path. The password stays in Secrets Manager.
RHO_DB_INSTANCE=rho-dp
RHO_DB_HOST=rho-dp.cxqyicswioh8.us-west-2.rds.amazonaws.com
RHO_DB_SECRET=rho/dp-rds
RHO_DB_SSLMODE=require

# Durable AWS MemoryDB queue with TLS, Multi-AZ replication, and
# maxmemory-policy=noeviction. Keep this separate from the fail-open
# ElastiCache URL used for disposable cache hints.
RHO_QUEUE_REDIS_URL=rediss://queue-user:password@cluster.example:6379
RHO_QUEUE_BACKEND=memorydb
RHO_QUEUE_CLUSTER=1
# Walkers receive only these publisher API settings, not Redis credentials.
RHO_QUEUE_PUBLISH_URL=https://ecc2k130-queue.internal
RHO_QUEUE_PUBLISH_TOKEN=
# RHO_REDIS_URL=rediss://optional-disposable-cache.example:6379

# Backpressure. Producers stop clearing their local spool at red; yellow is an
# early warning. Set these from the queue node size and measured drain rate.
RHO_QUEUE_HIGH_MESSAGES=10000
RHO_QUEUE_CRITICAL_MESSAGES=50000
RHO_QUEUE_HIGH_BYTES=2147483648
RHO_QUEUE_CRITICAL_BYTES=6442450944
RHO_QUEUE_HIGH_AGE_SECONDS=300
RHO_QUEUE_CRITICAL_AGE_SECONDS=1800
RHO_QUEUE_HIGH_MEMORY_RATIO=0.70
RHO_QUEUE_CRITICAL_MEMORY_RATIO=0.85
RHO_QUEUE_CLAIM_IDLE_MS=60000
RHO_QUEUE_MAX_DELIVERIES=8
RHO_QUEUE_MAX_DP_BYTES=8388608
RHO_QUEUE_MAX_CHECKPOINT_BYTES=17179869184

# Local/operator alternative to RHO_DB_HOST + RHO_DB_SECRET:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
