{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "campaign",
    "rds",
    "existingSecret",
    "queue",
    "publisher",
    "consumer"
  ],
  "properties": {
    "rolloutNonce": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "campaign": {
      "type": "object",
      "required": ["name", "awsRegion", "bucket", "statusBucket"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "contractId": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "awsRegion": { "type": "string", "minLength": 1 },
        "bucket": { "type": "string", "minLength": 3 },
        "statusBucket": { "type": "string", "minLength": 3 }
      }
    },
    "rds": {
      "type": "object",
      "required": ["host", "secretId", "sslMode"],
      "properties": {
        "host": { "type": "string" },
        "secretId": { "type": "string", "minLength": 1 },
        "databaseName": { "type": "string" },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": [
        "name",
        "producerRedisUrlKey",
        "consumerRedisUrlKey",
        "publishTokenKey",
        "migrationDatabaseUrlKey"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "producerRedisUrlKey": { "type": "string", "minLength": 1 },
        "consumerRedisUrlKey": { "type": "string", "minLength": 1 },
        "publishTokenKey": { "type": "string", "minLength": 1 },
        "runtimeDatabaseUrlKey": { "type": "string" },
        "migrationDatabaseUrlKey": { "type": "string", "minLength": 1 }
      }
    },
    "queue": {
      "type": "object",
      "required": [
        "backend",
        "cluster",
        "highMessages",
        "criticalMessages",
        "highBytes",
        "criticalBytes"
      ],
      "properties": {
        "backend": { "const": "memorydb" },
        "cluster": { "const": true },
        "blockMilliseconds": { "type": "integer", "minimum": 1 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "claimIdleMilliseconds": { "type": "integer", "minimum": 1000 },
        "maxDeliveries": { "type": "integer", "minimum": 1 },
        "maxDpBytes": { "type": "integer", "minimum": 32 },
        "maxCheckpointBytes": { "type": "integer", "minimum": 40 },
        "highMessages": { "type": "integer", "minimum": 1 },
        "criticalMessages": { "type": "integer", "minimum": 2 },
        "highBytes": { "type": "integer", "minimum": 1 },
        "criticalBytes": { "type": "integer", "minimum": 2 },
        "highAgeSeconds": { "type": "integer", "minimum": 1 },
        "criticalAgeSeconds": { "type": "integer", "minimum": 2 },
        "highMemoryRatio": {
          "type": "string",
          "pattern": "^0\\.[0-9]+$"
        },
        "criticalMemoryRatio": {
          "type": "string",
          "pattern": "^0\\.[0-9]+$"
        }
      }
    },
    "publisher": {
      "type": "object",
      "required": ["replicaCount", "port", "service"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "consumer": {
      "type": "object",
      "required": ["replicaCount"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": { "$ref": "#/definitions/serviceAccount" },
        "consumer": { "$ref": "#/definitions/serviceAccount" },
        "reconciler": { "$ref": "#/definitions/serviceAccount" }
      }
    },
    "reconciler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "runOnReconciler": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    }
  }
}
