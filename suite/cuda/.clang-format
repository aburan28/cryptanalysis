# The repository style, plus the F4 kernel's phase macros: F4_FOR_THREADS
# opens a block (a loop over emulated threads on the host) and
# F4_END_THREADS closes it, so their bodies are indented as blocks.
BasedOnStyle: InheritParentConfig
MacroBlockBegin: "^F4_FOR_THREADS$"
MacroBlockEnd: "^F4_END_THREADS$"
