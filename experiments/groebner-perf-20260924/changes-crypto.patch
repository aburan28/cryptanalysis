+//! Paired symbolic-preprocessing control on public synthetic Semaev systems.
+//! The original implementation is retained here solely as a benchmark control.
+use gbrl::f4::symbolic_preprocess;
+use gbrl::field::Fp;
+use gbrl::monomial::Monomial;
+use gbrl::poly::Poly;
+use gbrl::semaev::semaev_decomposition_3_instance;
+use gbrl::spoly::spoly;
+use std::collections::HashSet;
+use std::time::Instant;
+
+fn original(s_polys: Vec<Poly>, basis: &[Poly]) -> (Vec<Poly>, Vec<Monomial>) {
+    let mut rows = s_polys;
+    let mut seen: HashSet<(usize, Monomial)> = HashSet::new();
+    let mut work: Vec<Monomial> = rows.iter().flat_map(|p| p.terms.iter().map(|t| t.mono.clone())).collect();
+    while let Some(mono) = work.pop() {
+        for (idx, g) in basis.iter().enumerate() {
+            let Some(lm) = g.lm() else { continue; };
+            let Some(multiplier) = mono.div(lm) else { continue; };
+            if !seen.insert((idx, multiplier.clone())) { continue; }
+            let shifted = g.mul_term(Fp::one(), &multiplier);
+            for term in &shifted.terms { work.push(term.mono.clone()); }
+            rows.push(shifted);
+            break;
+        }
+    }
+    let mut columns: Vec<_> = rows.iter().flat_map(|p| p.terms.iter().map(|t| t.mono.clone())).collect();
+    columns.sort_by(|a,b| b.cmp(a)); columns.dedup();
+    (rows, columns)
+}
+
+fn median(samples: &[f64]) -> f64 {
+    let mut sorted = samples.to_vec(); sorted.sort_by(f64::total_cmp);
+    sorted[sorted.len()/2]
+}
+
+fn main() {
+    let mut cells = Vec::new();
+    for fb in [3, 4] {
+        let basis = semaev_decomposition_3_instance(fb);
+        let mut input = Vec::new();
+        for i in 0..basis.len() {
+            for j in i+1..basis.len() {
+                if !basis[i].lm().unwrap().gcd_is_one(basis[j].lm().unwrap()) {
+                    input.push(spoly(&basis[i], &basis[j]));
+                }
+            }
+        }
+        let mut samples = [Vec::new(), Vec::new()];
+        let mut shapes = [(0,0);2];
+        for repeat in 0..22 {
+            let order = if repeat % 2 == 0 { [0,1] } else { [1,0] };
+            for variant in order {
+                let start = Instant::now();
+                let (rows, cols) = if variant == 0 { original(input.clone(), &basis) }
+                    else { symbolic_preprocess(input.clone(), &basis) };
+                let ms = start.elapsed().as_secs_f64()*1000.0;
+                shapes[variant] = (rows.len(), cols.len());
+                if repeat > 0 { samples[variant].push(ms); }
+                // Check symbolic closure: every reducible column has a row
+                // whose leading monomial is exactly that column.
+                let leads: HashSet<_> = rows.iter().filter_map(|p| p.lm()).collect();
+                for m in &cols {
+                    if basis.iter().any(|g| g.lm().is_some_and(|lm| lm.divides(m))) {
+                        assert!(leads.contains(m));
+                    }
+                }
+            }
+        }
+        cells.push(serde_json::json!({"fb_size":fb,"repeats":21,
+            "original_shape":shapes[0],"optimized_shape":shapes[1],
+            "original_median_ms":median(&samples[0]),"optimized_median_ms":median(&samples[1]),
+            "speedup":median(&samples[0])/median(&samples[1]),
+            "original_samples_ms":samples[0],"optimized_samples_ms":samples[1]}));
+    }
+    println!("{}", serde_json::json!({"kind":"symbolic_preprocessing_only",
+        "claim":"Paired shared-host timings; symbolic closure checked; not a complete solve timing",
+        "cells":cells}));
+}
