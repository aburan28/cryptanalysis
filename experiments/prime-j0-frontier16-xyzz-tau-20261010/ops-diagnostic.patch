+#[derive(Clone, Copy, Default)]
+struct FieldOpCounts { add: u64, sub: u64, mul: u64, square: u64 }
+thread_local! {
+    static FIELD_OPS: std::cell::Cell<FieldOpCounts> =
+        const { std::cell::Cell::new(FieldOpCounts { add: 0, sub: 0, mul: 0, square: 0 }) };
+}
+fn reset_field_ops() { FIELD_OPS.with(|counter| counter.set(FieldOpCounts::default())); }
+fn field_ops() -> FieldOpCounts { FIELD_OPS.with(|counter| counter.get()) }
+
 fn u256_add(a: super::U256, b: super::U256) -> super::U256 {
+    FIELD_OPS.with(|counter| { let mut c = counter.get(); c.add += 1; counter.set(c); });
     a.add_mod(&b, &super::HYBRID_FIELD.0.n)
 }
 
 fn u256_sub(a: super::U256, b: super::U256) -> super::U256 {
+    FIELD_OPS.with(|counter| { let mut c = counter.get(); c.sub += 1; counter.set(c); });
     a.sub_mod(&b, &super::HYBRID_FIELD.0.n)
 }
 
 fn u256_mul(a: super::U256, b: super::U256) -> super::U256 {
+    FIELD_OPS.with(|counter| { let mut c = counter.get(); c.mul += 1; counter.set(c); });
     super::HYBRID_FIELD.0.mont_mul(&a, &b)
 }
 
 fn u256_square(a: super::U256) -> super::U256 {
