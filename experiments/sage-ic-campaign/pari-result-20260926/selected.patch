+    static bool bb_from_pari_element(NTL::GF2E& out, GEN value, GEN generator) {
+        // Only copy coordinates in this exact polynomial representation.
+        // Other PARI representations retain Sage's general coercion path.
+        if (!bb_pari_binary(value) || !bb_pari_binary(generator)
+                || !gequal(gel(value, 3), gel(generator, 3))) return false;
+        GEN f = gel(value, 2);
+        if (typ(f) != t_VECSMALL) return false;
+        const long words = lg(f) - 2;
+        const long wordbytes = sizeof(unsigned long);
+        std::vector<unsigned char> bytes(words * wordbytes);
+        // Explicit little-endian bytes: independent of host byte order.
+        for (long i = 0; i < words; ++i) {
+            unsigned long word = (unsigned long)f[i+2];
+            for (long j = 0; j < wordbytes; ++j)
+                bytes[i*wordbytes+j] = (unsigned char)(word >> (8*j));
+        }
+        NTL::GF2X polynomial;
+        NTL::GF2XFromBytes(polynomial, bytes.data(), bytes.size());
+        NTL::conv(out, polynomial);
+        return true;
+    }
