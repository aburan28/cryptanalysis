+def _frobenius_table(field, Py_ssize_t power):
+    """Build an immutable byte lookup table directly from NTL basis images."""
+    cdef Py_ssize_t degree = field.degree()
+    if degree < 2 or degree > 256 or power < 0 or power >= degree:
+        raise ValueError('unsupported field degree or unreduced power')
+    cdef Py_ssize_t words = (degree+31)//32
+    cdef Py_ssize_t byte_count = (degree+7)//8
+    cdef Py_ssize_t byte, digit, bit, word, low
+    basis = np.zeros((byte_count*8, words), dtype=np.uint32)
+    table = np.zeros((byte_count, 256, words), dtype=np.uint32)
+    cdef unsigned int[:, ::1] b = basis
+    cdef unsigned int[:, :, ::1] t = table
+    cdef FiniteField_ntl_gf2eElement model = field.zero()
+    model._cache.F.restore()
+    bb_basis_words(&b[0, 0], degree, power, words)
+    for byte in range(byte_count):
+        sig_check()
+        for bit in range(8):
+            low = 1 << bit
+            for digit in range(low):
+                for word in range(words):
+                    t[byte, low+digit, word] = t[byte, digit, word] ^ b[byte*8+bit, word]
+    result = table.reshape(-1)
+    result.setflags(write=False)
+    return result
