+def frobenius_add_pairs(curve, pairs, power=1):
+    r"""Return ``Frobenius^power(P) + Q`` for each pair on a Koblitz curve.
+
+    Input validation, output ordering and exceptional points follow
+    :func:`add_pairs`. Intermediate coordinate field elements are retained
+    natively; the usual Sage point is constructed only for each final result.
+    Negative powers are reduced modulo the field degree.
+
+    EXAMPLES::
+
+        sage: from sage.schemes.elliptic_curves.binary_batch import frobenius_add_pairs
+        sage: E = EllipticCurve(GF(2**5, 'z'), [1, 1, 0, 0, 1])
+        sage: P = E.random_point()
+        sage: frobenius_add_pairs(E, [(P, -P)], 0) == [E(0)]
+        True
+    """
+    a2 = _curve_coefficient(curve)
+    if (a2 != 0 and a2 != 1) or curve.a6() != 1:
+        raise ValueError('Frobenius point maps require a Koblitz curve')
+    power = integer_index(power) % int(curve.base_ring().degree())
+    from sage.schemes.elliptic_curves.ell_point import EllipticCurvePoint_finite_field
+    if (_native is not None and _native.supports(curve.base_ring())
+            and curve._point is EllipticCurvePoint_finite_field):
+        return _native._add_pairs(curve, pairs, a2, power)
+    pairs = list(pairs)
+    mapped = frobenius_points(curve, (P for P, Q in pairs), power)
+    return add_pairs(curve, zip(mapped, (Q for P, Q in pairs)))
