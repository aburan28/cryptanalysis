+    if px is None:
+        return pari([0])
+    field = curve.base_ring()
+    cdef FiniteField_ntl_gf2eElement x = px, y = py
+    if x.parent() is not field or y.parent() is not field:
+        raise ValueError('coordinates belong to a different field')
+    cdef Gen generator
+    try:
+        generator = field._binary_batch_pari_generator
+    except AttributeError:
+        generator = field.modulus()._pari_with_name(field.variable_name()).ffgen()
+        field._binary_batch_pari_generator = generator
