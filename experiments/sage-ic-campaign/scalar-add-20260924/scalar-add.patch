+def _construct_standard_point(curve, x, y, one):
+    """Initialize an ordinary finite-field point from verified affine data."""
+    if curve._point is not EllipticCurvePoint_finite_field:
+        raise ValueError('expected the standard finite-field point class')
+    cdef Element point
+    point = EllipticCurvePoint_finite_field.__new__(EllipticCurvePoint_finite_field)
+    point._parent = curve.point_homset()
+    point._codomain = curve
+    point._normalized = True
+    point._coords = (x, y, one)
+    return point
