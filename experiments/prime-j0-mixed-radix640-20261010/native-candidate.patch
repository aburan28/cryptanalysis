+    fn div_rem_radix640_fast(self) -> (Self, i32, usize) {
+        assert!(self.limbs[2] <= 1);
+        let low_seven = self.limbs[0] & 127;
+        let y_low = (self.limbs[0] >> 7) | (self.limbs[1] << 57);
+        let y_high = (self.limbs[1] >> 7) | (self.limbs[2] << 57);
+        // 2^64 = 5*K+1. The 129-bit coordinate is 128*(H*2^64+L)+low_seven.
+        const K: u64 = u64::MAX / 5;
+        let high_quotient = y_high / 5;
+        let high_remainder = y_high - 5 * high_quotient;
+        let low_quotient = y_low / 5;
+        let low_remainder = y_low - 5 * low_quotient;
+        let sum = high_remainder + low_remainder;
+        let carry = u64::from(sum >= 5);
+        let remainder = low_seven + 128 * (sum - 5 * carry);
+        let low_word = high_remainder * K + low_quotient + carry;
+        let quotient = Self {
+            negative: self.negative && (low_word != 0 || high_quotient != 0),
+            limbs: [low_word, high_quotient, 0],
+        };
+        let signed_remainder = if self.negative {
+            -(remainder as i32)
+        } else {
+            remainder as i32
+        };
+        (quotient, signed_remainder,
+         signed_remainder.rem_euclid(640) as usize)
+    }
