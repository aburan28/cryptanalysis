diff --git a/src/xorgauss.c b/src/xorgauss.c
index 0198635..945cdcb 100644
--- a/src/xorgauss.c
+++ b/src/xorgauss.c
@@ -52 +52,14 @@ int_t xorgauss_step_mask_top;
-int_t xorgauss_mask_list[__ID_SIZE__][__ID_SIZE__ + 1];
+int_t *xorgauss_mask_list[__ID_SIZE__];
+static size_t xorgauss_mask_list_capacity[__ID_SIZE__];
+
+static void ensure_mask_list_row(int_t index, size_t required) {
+	assert(index >= 0 && index < __ID_SIZE__);
+	if(xorgauss_mask_list_capacity[index] >= required) return;
+	size_t capacity = xorgauss_mask_list_capacity[index];
+	if(capacity < 8) capacity = 8;
+	while(capacity < required) capacity *= 2;
+	int_t *grown = realloc(xorgauss_mask_list[index], capacity * sizeof(int_t));
+	assert(grown != NULL);
+	xorgauss_mask_list[index] = grown;
+	xorgauss_mask_list_capacity[index] = capacity;
+}
@@ -666,0 +680,3 @@ bool xorgauss_infer(int_t v) {
+#ifndef __XG_ENHANCED__
+	ensure_mask_list_row(xorgauss_mask_list_top, 4);
+#endif
@@ -716,0 +733,2 @@ bool xorgauss_infer(int_t v) {
+		ensure_mask_list_row(xorgauss_mask_list_top,
+		                     (size_t)xorgauss_mask_list[xorgauss_mask_list_top][0] + 1);
@@ -799 +816,0 @@ void xorgauss_undo() {
-
