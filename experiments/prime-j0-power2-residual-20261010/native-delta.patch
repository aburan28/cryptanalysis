+        let b_min = i16::from_le_bytes(bytes[6..8].try_into().unwrap()) as i32;
+        let b_max = i16::from_le_bytes(bytes[8..10].try_into().unwrap()) as i32;
+        let seed_count = u32::from_le_bytes(bytes[10..14].try_into().unwrap()) as usize;
+        let pair_count = u32::from_le_bytes(bytes[14..18].try_into().unwrap()) as usize;
+        assert_eq!((bound, b_min, b_max, seed_count, pair_count),
+                   (149, -172, 172, 10_061, 80_521));
+        assert_eq!(&bytes[18..20], &[0, 0]);
+        let row_bytes = 8 * (b_max - b_min + 1) as usize;
+        let code_bytes = 4 * pair_count;
+        assert_eq!(bytes.len(), 20 + row_bytes + code_bytes + 4 * seed_count);
+        let atlas = Self { rows: &bytes[20..20 + row_bytes],
+                           codes: &bytes[20 + row_bytes..20 + row_bytes + code_bytes],
+                           seeds: &bytes[20 + row_bytes + code_bytes..],
+                           b_min, b_max };
+        assert_eq!(&atlas.seeds[..4], &[0, 0, 0, 0]);
+        let mut offset = 0usize;
+        for b in b_min..=b_max {
+            let (a_min, length, row_offset) = atlas.row(b);
+            assert_eq!(row_offset, offset);
+            for a in a_min..a_min + length as i32 {
+                let (digit, _, _, _) = atlas.digit_exact(a, b);
+                assert_eq!(digit, (a, b));
+            }
+            offset += length;
+        }
+        assert_eq!(offset, pair_count);
+        atlas
+    }
+
+    fn row(&self, b: i32) -> (i32, usize, usize) {
+        assert!((self.b_min..=self.b_max).contains(&b));
+        let row = &self.rows[8 * (b - self.b_min) as usize..][..8];
+        (i16::from_le_bytes(row[..2].try_into().unwrap()) as i32,
+         u16::from_le_bytes(row[2..4].try_into().unwrap()) as usize,
+         u32::from_le_bytes(row[4..8].try_into().unwrap()) as usize)
+    }
+
+    fn seed_digits(&self) -> Vec<(i16, i16)> {
+        self.seeds.chunks_exact(4).map(|chunk| {
+            (i16::from_le_bytes(chunk[..2].try_into().unwrap()),
+             i16::from_le_bytes(chunk[2..].try_into().unwrap()))
+        }).collect()
+    }
+
+    fn digit_exact(&self, a: i32, b: i32) -> ((i32, i32), usize, usize, usize) {
+        assert!(norm((a, b)) < 149 * 149);
+        let (a_min, length, offset) = self.row(b);
+        assert!(a >= a_min && (a - a_min) < length as i32);
+        let code_offset = 4 * (offset + (a - a_min) as usize);
+        let code = u32::from_le_bytes(
