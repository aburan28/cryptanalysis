+fn split_terminal_better(option: &SplitTerminalPath, current: &SplitTerminalPath) -> bool {
+    let first = (option.proxy, option.part_count, !option.baseline);
+    let second = (current.proxy, current.part_count, !current.baseline);
+    if first != second { return first < second; }
+    if option.representative == current.representative {
+        return option.parts < current.parts;
+    }
+    split_terminal_rank(option) < split_terminal_rank(current)
