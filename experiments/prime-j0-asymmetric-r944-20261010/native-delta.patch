+    fn div_rem_radix944_fast(self) -> (Self, i32, usize) {
+        assert!(self.limbs[2] <= 1);
+        let low_four = self.limbs[0] & 15;
+        let y_low = (self.limbs[0] >> 4) | (self.limbs[1] << 60);
+        let y_high = (self.limbs[1] >> 4) | (self.limbs[2] << 60);
+        // 2^64 = 59*K+5, and 944=16*59. Both word divisions are constant.
+        const K: u64 = u64::MAX / 59;
+        let high_quotient = y_high / 59;
+        let high_remainder = y_high - 59 * high_quotient;
+        let low_quotient = y_low / 59;
+        let low_remainder = y_low - 59 * low_quotient;
+        let folded = 5 * high_remainder + low_remainder;
+        let carry = folded / 59;
+        let remainder = low_four + 16 * (folded - 59 * carry);
+        let low_word = high_remainder * K + low_quotient + carry;
+        let quotient = Self {
+            negative: self.negative && (low_word != 0 || high_quotient != 0),
+            limbs: [low_word, high_quotient, 0],
+        };
+        let signed_remainder = if self.negative {
+            -(remainder as i32)
+        } else {
+            remainder as i32
+        };
+        (quotient, signed_remainder,
+         signed_remainder.rem_euclid(944) as usize)
+    }
