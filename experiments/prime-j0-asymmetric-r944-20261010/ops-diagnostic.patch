+    #[test]
+    fn asymmetric_radix944_source_operation_diagnostic() {
+        let panel_path = std::env::var("R944_PANEL").expect("R944_PANEL path required");
+        let panel: serde_json::Value = serde_json::from_str(
+            &std::fs::read_to_string(panel_path).unwrap()).unwrap();
+        let scalars = panel["scalars_hex"].as_array().unwrap();
+        assert_eq!(scalars.len(), 4096);
+        // Warm both tables before resetting counters; the comparison is per-scalar work.
+        assert_eq!(warm_format(59), 71_450_736);
+        assert_eq!(warm_format(58), 31_302_596);
+        let functions: [fn([u64; 4]) ->
+            (String, (Signed192, Signed192), usize, usize, bool, usize, usize); 2] = [
+            multiply_u256_tau_asymmetric_radix944_gauge_xyzz_tau,
+            multiply_u256_tau_mixed_radix640_gauge_xyzz_tau,
+        ];
+        let mut totals = [FieldOpCounts::default(); 2];
+        let mut additions = [0u64; 2];
+        let mut rotations = [0u64; 2];
+        for (index, text) in scalars.iter().enumerate() {
+            let scalar = BigInt::parse_bytes(text.as_str().unwrap().as_bytes(), 16).unwrap();
+            let words = super::super::scalar_words_256(&scalar).unwrap();
+            let mut expected = None;
+            for (mode, function) in functions.iter().enumerate() {
+                reset_field_ops();
+                let result = function(words);
+                let count = field_ops();
+                if let Some(ref point) = expected {
+                    assert_eq!(&result.0, point, "point {index}");
+                } else {
+                    expected = Some(result.0);
+                }
+                additions[mode] += result.2 as u64;
+                rotations[mode] += result.6 as u64;
+                totals[mode].add += count.add;
+                totals[mode].sub += count.sub;
+                totals[mode].mul += count.mul;
+                totals[mode].square += count.square;
+                totals[mode].solinas += count.solinas;
+                totals[mode].div5 += count.div5;
+                totals[mode].div5_small += count.div5_small;
+                totals[mode].div59 += count.div59;
+                totals[mode].div59_small += count.div59_small;
+                totals[mode].point_loads += count.point_loads;
+            }
+        }
+        assert_eq!(additions, [49_152, 53_248]);
+        assert_eq!(rotations, [14_838, 15_105]);
+        assert_eq!(totals[0].div59, 212_992);
+        assert_eq!(totals[0].div59_small, 106_496);
+        assert_eq!(totals[1].div5, 131_072);
+        assert_eq!(totals[1].div5_small, 65_536);
+        for (mode, name) in ["asymmetric_radix944", "mixed_radix640"].iter().enumerate() {
+            let c = totals[mode];
+            assert_eq!(c.point_loads, additions[mode] + 4096);
+            let products = 36 * (c.mul + c.square) + 23 * c.solinas;
+            println!("mode={name} cases=4096 mixed_additions={} rotations={} point_loads={} atlas_queries={} add={} sub={} generic_mul={} square={} solinas={} div5_large={} div5_small={} div59_large={} div59_small={} source_limb_products={}",
+                     additions[mode], rotations[mode], c.point_loads,
+                     (if mode == 0 {13} else {14}) * scalars.len(),
+                     c.add, c.sub, c.mul, c.square, c.solinas,
+                     c.div5, c.div5_small, c.div59, c.div59_small, products);
