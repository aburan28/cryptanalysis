# Checks chosen for a portable C11 numerics library: correctness and
# portability traps that the compilers and sanitizers do not already cover.
# Style checks are left to clang-format.
#
# Two disabled checks are worth explaining.  insecureAPI.DeprecatedOrUnsafe
# BufferHandling wants the Annex K *_s functions, which glibc does not ship.
# valist.Uninitialized misfires on textbook-correct `va_start`/`va_end` pairs
# in clang 18 (it flags src/util.c's ca_set_error, which is correct).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  -bugprone-easily-swappable-parameters,
  -bugprone-multi-level-implicit-pointer-conversion,
  -cert-err33-c,
  -cert-msc30-c,
  -cert-msc32-c,
  -cert-msc50-cpp,
  -cert-msc51-cpp,
  -misc-include-cleaner,
  -misc-no-recursion,
  -readability-magic-numbers,
  -bugprone-suspicious-string-compare,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-valist.Uninitialized
WarningsAsErrors: '*'
HeaderFilterRegex: '(include/cryptanalysis|src|cuda)/.*\.(h|cuh)$'
FormatStyle: file
